DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
LANGUAGE_CODE=es-CL
TIME_ZONE=America/Santiago

# ===== Producción (sólo cuando DEBUG=False) =====
# Dominios HTTPS confiables para el token CSRF (separados por coma).
# Ej: CSRF_TRUSTED_ORIGINS=https://ideas.cl,https://www.ideas.cl
CSRF_TRUSTED_ORIGINS=

# Redirige http→https. Dejar en False si el edge proxy ya redirige.
SECURE_SSL_REDIRECT=False

# HSTS en segundos. Usar 0 en el primer deploy, luego 31536000 (1 año) una
# vez estable todo el dominio (incluye subdominios automáticamente).
SECURE_HSTS_SECONDS=0

# Servir static files con WhiteNoise (recomendado para single-server deploys).
USE_WHITENOISE=True

# Nivel de log para el root logger.
LOG_LEVEL=INFO

# Pagos POS
# Opciones: mock | tuu | ruta.modulo.ClaseGateway
PAYMENT_GATEWAY=mock

# Credenciales TUU (Haulmer). Dejar vacío si se usa el gateway mock.
TUU_API_KEY=
TUU_DEVICE_SERIAL=
TUU_BASE_URL=https://integrations.payment.haulmer.com
# 39=boleta, 33=factura, 41=boleta exenta
TUU_DTE_TIPO=39

# Pagos ecommerce (Webpay / Transbank)
# Opciones: mock | webpay | ruta.modulo.ClaseGateway
ECOMMERCE_PAYMENT_GATEWAY=mock
# pk de bodega.Tienda que surte el canal online (0 = no configurado)
ECOMMERCE_TIENDA_ID=0
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_BASE_URL=https://webpay3gint.transbank.cl

# Email para boleta online. En dev se imprime en consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ventas@ideas.local

# Emisión de DTE (boleta electrónica al SII).
# Opciones: mock | openfactura | none | ruta.modulo.ClaseEmissor
DTE_EMISSOR=mock
# Credenciales OpenFactura (Haulmer). Vacíos si DTE_EMISSOR=mock.
OPENFACTURA_API_KEY=
OPENFACTURA_BASE_URL=https://api.haulmer.com
# RUT del comercio que emite la boleta (formato 12345678-9, sin puntos)
OPENFACTURA_RUT_EMISOR=
