# ════════════════════════════════════════════════════════════════════════
# Ideas Boutique 2.0 — Configuración por entorno
# ════════════════════════════════════════════════════════════════════════
# Copiá este archivo a `.env` y ajustá los valores. NUNCA pongas
# secretos reales acá — este archivo se commitea, .env NO.
#
# Ver SECURITY.md para el detalle de cada flag de hardening.
# ════════════════════════════════════════════════════════════════════════

# ── Base de Django ──────────────────────────────────────────────────────
# DEBUG: SIEMPRE False en producción. Con True se expone stacktraces +
# settings + queries al cliente. La única razón de tener True es en
# desarrollo local — definirlo en .env.local.
DEBUG=False
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-al-menos-50-chars
# Hosts que pueden servir tu app. En prod: ideasboutique.cl,www.ideasboutique.cl
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
LANGUAGE_CODE=es-CL
TIME_ZONE=America/Santiago

# ── Hardening (siempre seteado, no solo en prod) ────────────────────────
# Cambia el path del Django admin para que los bots que scanean /admin/
# y /wp-admin/ se pierdan. Usá algo único: tu nombre + sufijo aleatorio.
# Ej. en prod: ADMIN_URL=eduardo-blanca-x7k2/
ADMIN_URL=admin/

# Email del superusuario. Recibe alertas automáticas de errores 500
# cuando DEBUG=False. Vacío = sin alertas (solo logs en stderr).
ADMIN_EMAIL=

# Anti-fuerza-bruta (django-axes). Lockout tras N intentos.
# 5 intentos por (usuario + IP), 1 hora de bloqueo automático.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
# Detrás de reverse proxy (nginx, Cloudflare): cantidad de proxies para
# leer X-Forwarded-For correcto. nginx solo = 1. Cloudflare + nginx = 2.
AXES_PROXY_COUNT=0

# ── Producción HTTPS ────────────────────────────────────────────────────
# Dominios HTTPS confiables para el token CSRF (coma separados).
# Ej: CSRF_TRUSTED_ORIGINS=https://ideasboutique.cl,https://www.ideasboutique.cl
CSRF_TRUSTED_ORIGINS=

# Redirige http→https. True si Django termina TLS; False si nginx ya lo
# hace en el edge (evita loops). Para nuestro setup en Hetzner con nginx
# + Let's Encrypt → False (nginx hace el redirect).
SECURE_SSL_REDIRECT=False

# HSTS en segundos. 0 en el PRIMER deploy (por si algo falla con TLS),
# luego 31536000 (1 año) una vez confirmado HTTPS estable.
# ¡Cuidado! HSTS se cachea agresivamente en browsers — no se puede
# revertir sin tocar cada cliente.
SECURE_HSTS_SECONDS=0

# WhiteNoise sirve static files sin necesidad de configurarlos en nginx.
# Recomendado True; sirve los assets directamente desde gunicorn con
# Compressed Manifest (hash + gzip/brotli).
USE_WHITENOISE=True

LOG_LEVEL=INFO

# ── Pagos POS (TUU / Haulmer) ──────────────────────────────────────────
# Opciones: mock | tuu | ruta.modulo.ClaseGateway
PAYMENT_GATEWAY=mock
# Credenciales TUU. Dejar vacío si PAYMENT_GATEWAY=mock.
TUU_API_KEY=
TUU_DEVICE_SERIAL=
TUU_BASE_URL=https://integrations.payment.haulmer.com
# 39=boleta, 33=factura, 41=boleta exenta
TUU_DTE_TIPO=39

# ── Pagos ecommerce (Webpay / Transbank) ───────────────────────────────
# Opciones: mock | webpay | ruta.modulo.ClaseGateway
ECOMMERCE_PAYMENT_GATEWAY=mock
# pk de bodega.Tienda que surte el canal online (0 = no configurado)
ECOMMERCE_TIENDA_ID=0
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_BASE_URL=https://webpay3gint.transbank.cl

# ── Email transaccional ────────────────────────────────────────────────
# DEV: console backend (printea en stderr, no envia nada).
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# PROD (Zoho Mail): SMTP autenticado contra smtp.zoho.com:587 con TLS.
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.zoho.com   (si tu cuenta es EU usa smtp.zoho.eu)
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=ventas@ideasboutique.cl
#   EMAIL_HOST_PASSWORD=<app password de Zoho, NO la pass de login>
#
# Como generar el app password en Zoho:
#   1) https://accounts.zoho.com → Seguridad → App Passwords
#   2) Generar nueva, nombre "Django Ideas Boutique"
#   3) Copiar el password de 16 chars (se ve UNA sola vez)
#   4) Pegarlo en EMAIL_HOST_PASSWORD
# Razon: si activas 2FA en Zoho (recomendado), la pass de login deja
# de funcionar para SMTP. App passwords son revocables individualmente.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Direccion en el "From:" de cada mail. En Zoho debe coincidir con
# EMAIL_HOST_USER o ser un alias verificado de esa cuenta.
DEFAULT_FROM_EMAIL=Ideas Boutique <ventas@ideasboutique.cl>
# De donde salen los mails AUTOMATICOS de Django (errores 500 a ADMINS
# cuando DEBUG=False). Si esta vacio, cae a DEFAULT_FROM_EMAIL.
SERVER_EMAIL=
# Timeout en segundos para el socket SMTP. Sin esto, un Zoho caido
# colgaria el request del usuario hasta el timeout del SO (~2 min).
EMAIL_TIMEOUT=10

# ── Emisión de DTE (boleta electrónica al SII) ─────────────────────────
# Opciones: mock | openfactura | none | ruta.modulo.ClaseEmissor
DTE_EMISSOR=mock
OPENFACTURA_API_KEY=
OPENFACTURA_BASE_URL=https://api.haulmer.com
# RUT del comercio (formato 12345678-9, sin puntos)
OPENFACTURA_RUT_EMISOR=

# ── SEO + ops (opcionales) ─────────────────────────────────────────────
# URL pública del sitio. Si está vacía, el sitemap y los links de email
# usan el host del request (correcto en mayoría de casos).
SITE_URL=
# Email que recibe notificación al instante de cada venta online pagada.
OWNER_NOTIFICATION_EMAIL=
# Dominio Plausible para analytics privacy-first. Vacío = sin tracking.
ANALYTICS_DOMAIN=
# WhatsApp del local (formato E.164 sin +, ej. 56912345678).
PUBLIC_WHATSAPP=

# ── Feature flags ───────────────────────────────────────────────────────
# Bloque 9 (reseñas reales). Off hasta que haya capacidad de moderar.
FEATURE_RESENAS=False
