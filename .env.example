# ════════════════════════════════════════════════════════════════════════
# Ideas Boutique 2.0 — Configuración por entorno
# ════════════════════════════════════════════════════════════════════════
# Copiá este archivo a `.env` y ajustá los valores. NUNCA pongas
# secretos reales acá — este archivo se commitea, .env NO.
#
# Ver SECURITY.md para el detalle de cada flag de hardening.
# ════════════════════════════════════════════════════════════════════════

# ── Base de Django ──────────────────────────────────────────────────────
# DEBUG: SIEMPRE False en producción. Con True se expone stacktraces +
# settings + queries al cliente. La única razón de tener True es en
# desarrollo local — definirlo en .env.local.
DEBUG=False
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-al-menos-50-chars
# Hosts que pueden servir tu app. En prod: ideasboutique.cl,www.ideasboutique.cl
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
LANGUAGE_CODE=es-CL
TIME_ZONE=America/Santiago

# ── Hardening (siempre seteado, no solo en prod) ────────────────────────
# Cambia el path del Django admin para que los bots que scanean /admin/
# y /wp-admin/ se pierdan. Usá algo único: tu nombre + sufijo aleatorio.
# Ej. en prod: ADMIN_URL=eduardo-blanca-x7k2/
ADMIN_URL=admin/

# Email del superusuario. Recibe alertas automáticas de errores 500
# cuando DEBUG=False. Vacío = sin alertas (solo logs en stderr).
ADMIN_EMAIL=

# Anti-fuerza-bruta (django-axes). Lockout tras N intentos.
# 5 intentos por (usuario + IP), 1 hora de bloqueo automático.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
# Detrás de reverse proxy (nginx, Cloudflare): cantidad de proxies para
# leer X-Forwarded-For correcto. nginx solo = 1. Cloudflare + nginx = 2.
AXES_PROXY_COUNT=0

# ── Producción HTTPS ────────────────────────────────────────────────────
# Dominios HTTPS confiables para el token CSRF (coma separados).
# Ej: CSRF_TRUSTED_ORIGINS=https://ideasboutique.cl,https://www.ideasboutique.cl
CSRF_TRUSTED_ORIGINS=

# Redirige http→https. True si Django termina TLS; False si nginx ya lo
# hace en el edge (evita loops). Para nuestro setup en Hetzner con nginx
# + Let's Encrypt → False (nginx hace el redirect).
SECURE_SSL_REDIRECT=False

# HSTS en segundos. 0 en el PRIMER deploy (por si algo falla con TLS),
# luego 31536000 (1 año) una vez confirmado HTTPS estable.
# ¡Cuidado! HSTS se cachea agresivamente en browsers — no se puede
# revertir sin tocar cada cliente.
SECURE_HSTS_SECONDS=0

# WhiteNoise sirve static files sin necesidad de configurarlos en nginx.
# Recomendado True; sirve los assets directamente desde gunicorn con
# Compressed Manifest (hash + gzip/brotli).
USE_WHITENOISE=True

LOG_LEVEL=INFO

# ── Pagos POS (TUU / Haulmer) ──────────────────────────────────────────
# Opciones: mock | tuu | ruta.modulo.ClaseGateway
PAYMENT_GATEWAY=mock
# Credenciales TUU. Dejar vacío si PAYMENT_GATEWAY=mock.
TUU_API_KEY=
TUU_DEVICE_SERIAL=
TUU_BASE_URL=https://integrations.payment.haulmer.com
# 39=boleta, 33=factura, 41=boleta exenta
TUU_DTE_TIPO=39

# ── Pagos ecommerce (multi-gateway) ────────────────────────────────────
# Lista CSV de gateways activos: mock | klap | khipu. El cliente elige
# en el checkout si hay más de uno. El primero es el default (o forzar
# con ECOMMERCE_GATEWAY_DEFAULT).
ECOMMERCE_GATEWAYS_ACTIVOS=mock
ECOMMERCE_GATEWAY_DEFAULT=
# pk de bodega.Tienda que surte el canal online (0 = no configurado)
ECOMMERCE_TIENDA_ID=0

# Khipu (transferencia bancaria, ~0,79%) — API v3.
#   KHIPU_API_KEY:     panel khipu.com → "API Keys" (header x-api-key).
#   KHIPU_SECRET:      "Llave de cobrador" — firma HMAC de los webhooks.
#   KHIPU_RECEIVER_ID: "Id de cobrador" (informativo).
# Con KHIPU_API_KEY vacío el gateway opera en mock (simulador local).
KHIPU_API_KEY=
KHIPU_SECRET=
KHIPU_RECEIVER_ID=
KHIPU_BASE_URL=https://payment-api.khipu.com

# Mercado Pago (Checkout Pro, ~3% + IVA) — billetera + tarjetas + cuotas.
# Del panel mercadopago.cl/developers → "Tus integraciones" → tu app:
#   MERCADOPAGO_ACCESS_TOKEN:   Credenciales → Access Token. Hay dos juegos,
#                               "de prueba" y "de producción" (ambos APP_USR-):
#                               el de prueba para testear, el de producción
#                               para cobrar de verdad.
#   MERCADOPAGO_PUBLIC_KEY:     Public Key (informativo por ahora).
#   MERCADOPAGO_WEBHOOK_SECRET: Webhooks → "Clave secreta" (firma x-signature).
# Con ACCESS_TOKEN vacío el gateway opera en mock. Activar: agregar
# `mercadopago` a ECOMMERCE_GATEWAYS_ACTIVOS.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com

# KLAP (tarjetas, ~2,75%) — pendiente de credenciales del comercio.
KLAP_COMMERCE_ID=
KLAP_API_KEY=
KLAP_WEBHOOK_SECRET=
KLAP_BASE_URL=https://sandbox.klap.cl

# Transferencia bancaria DIRECTA (sin pasarela, confirmación manual).
# Respaldo activable: agregar `transferencia` a ECOMMERCE_GATEWAYS_ACTIVOS
# y llenar los datos de la cuenta. El cliente ve estos datos + manda el
# comprobante por WhatsApp; la dueña confirma el abono en Despacho →
# "Por confirmar". Sin datos, el método no aparece en el checkout.
TRANSFERENCIA_NOMBRE=
TRANSFERENCIA_RUT=
TRANSFERENCIA_BANCO=
TRANSFERENCIA_TIPO_CUENTA=
TRANSFERENCIA_CUENTA=
TRANSFERENCIA_EMAIL=

# ── Email transaccional ────────────────────────────────────────────────
# DEV: console backend (printea en stderr, no envia nada).
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# PROD (Zoho Mail): SMTP autenticado contra smtp.zoho.com:587 con TLS.
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.zoho.com   (si tu cuenta es EU usa smtp.zoho.eu)
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=ventas@ideasboutique.cl
#   EMAIL_HOST_PASSWORD=<app password de Zoho, NO la pass de login>
#
# Como generar el app password en Zoho:
#   1) https://accounts.zoho.com → Seguridad → App Passwords
#   2) Generar nueva, nombre "Django Ideas Boutique"
#   3) Copiar el password de 16 chars (se ve UNA sola vez)
#   4) Pegarlo en EMAIL_HOST_PASSWORD
# Razon: si activas 2FA en Zoho (recomendado), la pass de login deja
# de funcionar para SMTP. App passwords son revocables individualmente.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Direccion en el "From:" de cada mail. En Zoho debe coincidir con
# EMAIL_HOST_USER o ser un alias verificado de esa cuenta.
DEFAULT_FROM_EMAIL=Ideas Boutique <ventas@ideasboutique.cl>
# De donde salen los mails AUTOMATICOS de Django (errores 500 a ADMINS
# cuando DEBUG=False). Si esta vacio, cae a DEFAULT_FROM_EMAIL.
SERVER_EMAIL=
# Timeout en segundos para el socket SMTP. Sin esto, un Zoho caido
# colgaria el request del usuario hasta el timeout del SO (~2 min).
EMAIL_TIMEOUT=10

# ── Emisión de DTE (boleta electrónica al SII) ─────────────────────────
# Opciones: mock | openfactura | none | ruta.modulo.ClaseEmissor
DTE_EMISSOR=mock
OPENFACTURA_API_KEY=
OPENFACTURA_BASE_URL=https://api.haulmer.com
# RUT del comercio (formato 12345678-9, sin puntos)
OPENFACTURA_RUT_EMISOR=

# ── SEO + ops (opcionales) ─────────────────────────────────────────────
# URL pública del sitio. Si está vacía, el sitemap y los links de email
# usan el host del request (correcto en mayoría de casos).
SITE_URL=
# Email(s) que reciben notificación de cada venta online pagada y de
# cada pedido esperando transferencia. Acepta VARIOS separados por coma:
#   OWNER_NOTIFICATION_EMAIL=duena@gmail.com,hijo@gmail.com
OWNER_NOTIFICATION_EMAIL=
# Plausible Analytics (privacy-first, sin cookies). Self-hosteado en
# plausible.ideasboutique.cl. El valor es el dominio del SITIO trackeado
# (no el del Plausible). Vacio = sin analytics.
ANALYTICS_DOMAIN=
# Microsoft Clarity project ID — heatmaps + session replays + scroll maps.
# Generarlo en https://clarity.microsoft.com -> New project. Vacio = sin
# heatmaps. Gratis para siempre, GDPR-compliant.
CLARITY_PROJECT_ID=
# Google tag (gtag.js) para Google Ads / GA4 — el ID "G-XXXXXXXXXX" que
# muestra el panel de Google. Vacio = sin tag. Con esto puesto, el sitio
# ademas dispara el evento `purchase` (con transaction_id y monto) UNA
# vez por compra pagada — usarlo como accion de conversion en Ads.
GOOGLE_TAG_ID=
# Meta Pixel (Facebook/Instagram Ads) — retargeting + conversiones. El ID
# numerico del Administrador de Eventos de Meta (business.facebook.com ->
# Eventos). Vacio = sin pixel. Es publicidad: solo se inicializa cuando el
# visitante acepta las cookies, y el aviso de cookies cambia el texto para
# reflejar que hay publicidad. Dispara `Purchase` una vez por compra pagada.
META_PIXEL_ID=
# WhatsApp del local (formato E.164 sin +, ej. 56912345678).
PUBLIC_WHATSAPP=
# Google Maps — mapa incrustado en "Visítanos" e /info/#contacto.
#   GOOGLE_MAPS_EMBED_URL: el `src` del iframe. Lo mejor: abrir tu ficha en
#     Google Maps -> Compartir -> "Insertar un mapa" -> copiar el src del
#     iframe. Eso muestra el negocio con horario en vivo y reseñas. Si lo
#     dejas con el default (por direccion), muestra un pin sin la ficha.
#   GOOGLE_MAPS_PLACE_URL: link a la ficha (horario en vivo, reseñas, ruta).
# Vacio en cualquiera de los dos = se oculta esa parte.
GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps?q=Ideas+Boutique,+Caupolic%C3%A1n+437-B,+Los+Vilos,+Chile&z=16&output=embed
GOOGLE_MAPS_PLACE_URL=https://www.google.com/maps/search/?api=1&query=Ideas+Boutique,+Caupolic%C3%A1n+437-B,+Los+Vilos,+Chile

# ── WhatsApp automático (Meta Cloud API) — funcionalidad activable ─────
# Apagado hasta completar el setup en Meta (ver docs/whatsapp_api.md):
# verificación del negocio + número dedicado + plantillas aprobadas.
# El botón manual "Avisar por WhatsApp" del despacho funciona SIEMPRE,
# con o sin esto.
FEATURE_WHATSAPP_AUTO=False
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Feature flags ───────────────────────────────────────────────────────
# Bloque 9 (reseñas reales). Off hasta que haya capacidad de moderar.
FEATURE_RESENAS=False
# Envíos a domicilio. False = la tienda opera SOLO con retiro en local:
# el checkout no pide dirección y se oculta toda referencia a envíos.
# Activar cuando se defina el servicio (local primero, courier después).
FEATURE_ENVIOS=False
