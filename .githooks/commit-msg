#!/usr/bin/env bash
# Pre-receive: rechaza el commit si el mensaje incluye una linea de
# coautoria a herramientas de AI. Ver AGENTS.md.
#
# El argumento $1 es el path al archivo temporal con el mensaje del
# commit que git va a registrar.

MSG_FILE="$1"

# Patron: lineas "Co-Authored-By:" que mencionen Claude, Anthropic,
# Copilot, ChatGPT, GPT, OpenAI. Case-insensitive.
PATTERN='(?i)^^Co-Authored-By:.*(claude|anthropic|copilot|chatgpt|openai|gpt-)'

if grep -qiE '^Co-Authored-By:.*(claude|anthropic|copilot|chatgpt|openai|gpt-)' "$MSG_FILE"; then
  echo "ERROR: el mensaje del commit incluye una linea 'Co-Authored-By:'" >&2
  echo "       referenciando una herramienta de AI. Ver AGENTS.md."        >&2
  echo                                                                      >&2
  echo "Linea(s) ofensiva(s):"                                             >&2
  grep -niE '^Co-Authored-By:.*(claude|anthropic|copilot|chatgpt|openai|gpt-)' "$MSG_FILE" >&2
  echo                                                                      >&2
  echo "Para arreglar: editar el mensaje sin esa linea y reintentar."      >&2
  exit 1
fi

exit 0
