# ════════════════════════════════════════════════════════════════════════
# .env DE PRODUCCION para Ideas Boutique 2.0 (Hetzner VPS)
# ════════════════════════════════════════════════════════════════════════
# Este archivo es un TEMPLATE — los valores reales se completan en el
# VPS, NUNCA se commitea con secretos reales. Permisos en el server:
# chmod 600 /srv/ideas/app/.env
# ════════════════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=GENERAR_CON_get_random_secret_key__50_chars_minimo
ALLOWED_HOSTS=ideasboutique.cl,www.ideasboutique.cl
DATABASE_URL=postgresql://ideas:PASSWORD_DE_04_postgres_init@localhost:5432/ideas
LANGUAGE_CODE=es-CL
TIME_ZONE=America/Santiago
CSRF_TRUSTED_ORIGINS=https://ideasboutique.cl,https://www.ideasboutique.cl

# ── Hardening ───────────────────────────────────────────────────────────
# Path no-obvio para el Django admin (los bots scanean /admin/, /wp-admin/).
# Sugerencia: usar `python -c "import secrets; print('admin-'+secrets.token_urlsafe(6)+'/')"`.
ADMIN_URL=cambiar-por-algo-aleatorio/

# Email del super admin — recibe alertas automaticas de 500s.
ADMIN_EMAIL=shaggyxreload@gmail.com

# Anti-fuerza-bruta. 5 intentos por (user+IP), 1 hora de lockout.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
# nginx delante de gunicorn = 1 proxy. (Si agregas Cloudflare = 2.)
AXES_PROXY_COUNT=1

# ── HTTPS ───────────────────────────────────────────────────────────────
# nginx hace el redirect http→https — Django NO debe duplicar (anti-loops).
SECURE_SSL_REDIRECT=False

# HSTS: arrancá en 0 durante las primeras 48 horas. Una vez confirmado
# que todo carga en HTTPS sin bugs, cambiá a 31536000 (1 año) y reinicia
# gunicorn. NO se puede revertir sin tocar cada cliente — esperá a estar
# seguro antes de activarlo.
SECURE_HSTS_SECONDS=0

USE_WHITENOISE=True
LOG_LEVEL=INFO

# Paths de artifactos generados/subidos. Viven FUERA del checkout de git
# para que `git pull` u otros deploys no toquen el resultado de
# `collectstatic` ni las fotos subidas por el admin. Si los dejas vacios,
# Django cae a BASE_DIR/staticfiles y BASE_DIR/media (util en dev).
STATIC_ROOT=/srv/ideas/staticfiles
MEDIA_ROOT=/srv/ideas/media

# Modos del sitio. Tres modos posibles:
#   normal         tienda abierta al publico
#   landing        solo se ve la home + /info/; el resto redirige a /
#   mantenimiento  pagina "Volvemos pronto" en todo (HTTP 503)
# Toggle rapido (no necesita restart):
#   sudo -u ideas /srv/ideas/venv/bin/python /srv/ideas/app/manage.py modo landing
#   sudo -u ideas /srv/ideas/venv/bin/python /srv/ideas/app/manage.py modo mantenimiento
#   sudo -u ideas /srv/ideas/venv/bin/python /srv/ideas/app/manage.py modo normal
MAINTENANCE_FLAG_FILE=/srv/ideas/MAINTENANCE
LANDING_ONLY_FLAG_FILE=/srv/ideas/LANDING_ONLY

# ── Email (SMTP real) ──────────────────────────────────────────────────
# Para Gmail: generar un "App password" en https://myaccount.google.com/apppasswords
# (requiere 2FA activado).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ventas@ideasboutique.cl
EMAIL_HOST_PASSWORD=GENERAR_APP_PASSWORD_DE_GOOGLE
DEFAULT_FROM_EMAIL=ventas@ideasboutique.cl

# Notificacion al instante de cada venta online pagada.
OWNER_NOTIFICATION_EMAIL=shaggyxreload@gmail.com

# ── Backups (Backblaze B2) ──────────────────────────────────────────────
# Crear bucket en https://www.backblaze.com/b2/ y application key
# con scope al bucket.
B2_ACCOUNT_ID=tu_application_key_ID
B2_APPLICATION_KEY=tu_application_key
B2_BUCKET=ideas-backups-2026
# Passphrase para encriptar los pg_dumps antes de subir (gpg symmetric).
# GUARDALA EN UN GESTOR — sin esto NO se puede restaurar.
BACKUP_GPG_PASSPHRASE=passphrase-muy-fuerte-de-32-chars-minimo

# ── Pagos ───────────────────────────────────────────────────────────────
# Por ahora MOCK — activar Webpay/TUU cuando tengas las credenciales
# reales del comercio.
PAYMENT_GATEWAY=mock
TUU_API_KEY=
TUU_DEVICE_SERIAL=
TUU_BASE_URL=https://integrations.payment.haulmer.com
TUU_DTE_TIPO=39

ECOMMERCE_PAYMENT_GATEWAY=mock
ECOMMERCE_TIENDA_ID=1
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_BASE_URL=https://webpay3gint.transbank.cl

# ── Boleta electronica (SII) ────────────────────────────────────────────
DTE_EMISSOR=mock
OPENFACTURA_API_KEY=
OPENFACTURA_BASE_URL=https://api.haulmer.com
OPENFACTURA_RUT_EMISOR=
# Lista (separada por coma) de canales que SI emiten boleta SII. Hoy solo
# las ventas online — la tienda fisica no emite hasta integrar TUU. Cuando
# el local fisico arranque y la TUU este integrada, cambiar a:
#   DTE_CANALES_HABILITADOS=online,presencial
DTE_CANALES_HABILITADOS=online

# ── SEO + analytics ─────────────────────────────────────────────────────
SITE_URL=https://ideasboutique.cl
ANALYTICS_DOMAIN=ideasboutique.cl
PUBLIC_WHATSAPP=569XXXXXXXX

# ── Feature flags ───────────────────────────────────────────────────────
FEATURE_RESENAS=False
