# ════════════════════════════════════════════════════════════════════════
# .env DE PRODUCCION para Ideas Boutique 2.0 (Hetzner VPS)
# ════════════════════════════════════════════════════════════════════════
# Este archivo es un TEMPLATE — los valores reales se completan en el
# VPS, NUNCA se commitea con secretos reales. Permisos en el server:
# chmod 600 /srv/ideas/app/.env
# ════════════════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=GENERAR_CON_get_random_secret_key__50_chars_minimo
ALLOWED_HOSTS=ideasboutique.cl,www.ideasboutique.cl
DATABASE_URL=postgresql://ideas:PASSWORD_DE_04_postgres_init@localhost:5432/ideas
LANGUAGE_CODE=es-CL
TIME_ZONE=America/Santiago
CSRF_TRUSTED_ORIGINS=https://ideasboutique.cl,https://www.ideasboutique.cl

# ── Hardening ───────────────────────────────────────────────────────────
# Path no-obvio para el Django admin (los bots scanean /admin/, /wp-admin/).
# Sugerencia: usar `python -c "import secrets; print('admin-'+secrets.token_urlsafe(6)+'/')"`.
ADMIN_URL=cambiar-por-algo-aleatorio/

# Email del super admin — recibe alertas automaticas de 500s.
ADMIN_EMAIL=shaggyxreload@gmail.com

# Anti-fuerza-bruta. 5 intentos por (user+IP), 1 hora de lockout.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
# nginx delante de gunicorn = 1 proxy. (Si agregas Cloudflare = 2.)
AXES_PROXY_COUNT=1

# ── HTTPS ───────────────────────────────────────────────────────────────
# nginx hace el redirect http→https — Django NO debe duplicar (anti-loops).
SECURE_SSL_REDIRECT=False

# HSTS: arrancá en 0 durante las primeras 48 horas. Una vez confirmado
# que todo carga en HTTPS sin bugs, cambiá a 31536000 (1 año) y reinicia
# gunicorn. NO se puede revertir sin tocar cada cliente — esperá a estar
# seguro antes de activarlo.
SECURE_HSTS_SECONDS=0

USE_WHITENOISE=True
LOG_LEVEL=INFO

# Paths de artifactos generados/subidos. Viven FUERA del checkout de git
# para que `git pull` u otros deploys no toquen el resultado de
# `collectstatic` ni las fotos subidas por el admin. Si los dejas vacios,
# Django cae a BASE_DIR/staticfiles y BASE_DIR/media (util en dev).
STATIC_ROOT=/srv/ideas/staticfiles
MEDIA_ROOT=/srv/ideas/media

# Modos del sitio. Cuatro modos posibles:
#   normal         tienda abierta; la home muestra la landing
#   tienda         tienda abierta; la home va directo al catalogo (sin landing)
#   landing        solo se ve la home + /info/; el resto redirige a /
#   mantenimiento  pagina "Volvemos pronto" en todo (HTTP 503)
# Toggle rapido (no necesita restart), ej.:
#   sudo -u ideas /srv/ideas/venv/bin/python /srv/ideas/app/manage.py modo tienda
#   sudo -u ideas /srv/ideas/venv/bin/python /srv/ideas/app/manage.py modo normal
MAINTENANCE_FLAG_FILE=/srv/ideas/MAINTENANCE
LANDING_ONLY_FLAG_FILE=/srv/ideas/LANDING_ONLY
TIENDA_DIRECTA_FLAG_FILE=/srv/ideas/TIENDA_DIRECTA

# ── Email (SMTP real) — Zoho Mail ──────────────────────────────────────
# Cuenta `ventas@ideasboutique.cl` en Zoho Mail (plan Mail Lite, US DC).
# DNS configurado en Hetzner DNS Console: MX + SPF + DKIM (selector
# zmail._domainkey) + DMARC apuntando a Zoho. Ver setup en docs/email.md.
#
# IMPORTANTE: la password aca NO es la de login del webmail. Es un
# "App password" generado en https://accounts.zoho.com → Seguridad
# → App Passwords (requiere 2FA activado). Es revocable individualmente.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ventas@ideasboutique.cl
EMAIL_HOST_PASSWORD=GENERAR_APP_PASSWORD_EN_ZOHO_ACCOUNTS
DEFAULT_FROM_EMAIL=Ideas Boutique <ventas@ideasboutique.cl>
SERVER_EMAIL=ventas@ideasboutique.cl
EMAIL_TIMEOUT=10

# Notificacion al instante de cada venta online pagada + pedidos
# esperando transferencia. Acepta VARIOS correos separados por coma
# (duena + hijo para corroborar):
#   OWNER_NOTIFICATION_EMAIL=ideasdeblanca@gmail.com,eduardo.tapia.contreras@gmail.com
OWNER_NOTIFICATION_EMAIL=shaggyxreload@gmail.com

# ── Backups (Backblaze B2) ──────────────────────────────────────────────
# Crear bucket en https://www.backblaze.com/b2/ y application key
# con scope al bucket.
B2_ACCOUNT_ID=tu_application_key_ID
B2_APPLICATION_KEY=tu_application_key
B2_BUCKET=ideas-backups-2026
# Passphrase para encriptar los pg_dumps antes de subir (gpg symmetric).
# GUARDALA EN UN GESTOR — sin esto NO se puede restaurar.
BACKUP_GPG_PASSPHRASE=passphrase-muy-fuerte-de-32-chars-minimo

# ── Pagos ───────────────────────────────────────────────────────────────
# Por ahora MOCK — activar Webpay/TUU cuando tengas las credenciales
# reales del comercio.
PAYMENT_GATEWAY=mock
TUU_API_KEY=
TUU_DEVICE_SERIAL=
TUU_BASE_URL=https://integrations.payment.haulmer.com
TUU_DTE_TIPO=39

# Tienda donde se carga el stock vendido online (PK de bodega.Tienda).
ECOMMERCE_TIENDA_ID=1

# Multi-gateway online: lista de gateways habilitados. El primero es el
# default (o se puede forzar con ECOMMERCE_GATEWAY_DEFAULT). El cliente
# elige en el checkout si hay mas de uno activo.
#   - mercadopago = billetera + tarjetas + cuotas (Checkout Pro). ~3% + IVA.
#   - klap   = tarjeta credito/debito (KLAP/Multicaja). Comision ~2,75%.
#   - khipu  = transferencia bancaria. Comision ~0,79% (la mas baja).
#   - transferencia = transferencia directa, confirmacion manual. Sin comision.
#   - mock   = simulador para dev/staging (no toca red).
# Ej. para salir con Mercado Pago + respaldo de transferencia:
#   ECOMMERCE_GATEWAYS_ACTIVOS=mercadopago,transferencia
ECOMMERCE_GATEWAYS_ACTIVOS=mock
ECOMMERCE_GATEWAY_DEFAULT=

# KLAP — credenciales (sandbox por default, prod cuando se certifique)
KLAP_COMMERCE_ID=
KLAP_API_KEY=
KLAP_WEBHOOK_SECRET=
KLAP_BASE_URL=https://sandbox.klap.cl

# Transferencia bancaria DIRECTA (sin pasarela) — respaldo activable.
# Activar: agregar `transferencia` a ECOMMERCE_GATEWAYS_ACTIVOS (puede
# convivir con khipu: ECOMMERCE_GATEWAYS_ACTIVOS=khipu,transferencia) y
# llenar la cuenta donde transfieren los clientes. La duena confirma
# cada abono a mano en Despacho -> "Por confirmar" (contra la cartola).
TRANSFERENCIA_NOMBRE=
TRANSFERENCIA_RUT=
TRANSFERENCIA_BANCO=
TRANSFERENCIA_TIPO_CUENTA=
TRANSFERENCIA_CUENTA=
TRANSFERENCIA_EMAIL=

# Khipu — API v3. Del panel khipu.com (seccion "Para integrar Khipu"):
#   KHIPU_API_KEY     = API Key (boton "Nueva API Key") — header x-api-key
#   KHIPU_SECRET      = "Llave de cobrador" — verifica la firma de webhooks
#   KHIPU_RECEIVER_ID = "Id de cobrador"
# Para activar cobros reales: ECOMMERCE_GATEWAYS_ACTIVOS=khipu + restart.
KHIPU_API_KEY=
KHIPU_RECEIVER_ID=
KHIPU_SECRET=
KHIPU_BASE_URL=https://payment-api.khipu.com

# Mercado Pago — Checkout Pro (billetera + tarjetas + cuotas, ~3% + IVA).
# Del panel mercadopago.cl/developers -> "Tus integraciones" -> tu app:
#   MERCADOPAGO_ACCESS_TOKEN   = Credenciales de PRODUCCION -> Access Token
#                                (APP_USR-...). Para testear, usar el Access
#                                Token de las credenciales de PRUEBA (tambien
#                                APP_USR-) + usuario y tarjetas de prueba.
#   MERCADOPAGO_WEBHOOK_SECRET = Webhooks -> "Clave secreta" (firma x-signature)
#   MERCADOPAGO_PUBLIC_KEY     = Public Key (informativo)
# Para activar: ECOMMERCE_GATEWAYS_ACTIVOS=mercadopago,transferencia + restart.
# En el panel, configurar la URL de webhook:
#   https://ideasboutique.cl/tienda/pago/webhook/mercadopago/
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com

# ── Boleta electronica (SII) ────────────────────────────────────────────
DTE_EMISSOR=mock
OPENFACTURA_API_KEY=
OPENFACTURA_BASE_URL=https://api.haulmer.com
OPENFACTURA_RUT_EMISOR=
# Lista (separada por coma) de canales que SI emiten boleta SII. Hoy solo
# las ventas online — la tienda fisica no emite hasta integrar TUU. Cuando
# el local fisico arranque y la TUU este integrada, cambiar a:
#   DTE_CANALES_HABILITADOS=online,presencial
DTE_CANALES_HABILITADOS=online

# ── SEO + analytics ─────────────────────────────────────────────────────
SITE_URL=https://ideasboutique.cl
# Plausible self-host en plausible.ideasboutique.cl (ver deploy/plausible/).
# Una vez deployado, este valor activa el script en el HTML.
ANALYTICS_DOMAIN=ideasboutique.cl
# Microsoft Clarity — pegar el project ID despues de crear el proyecto en
# https://clarity.microsoft.com.
CLARITY_PROJECT_ID=
# Google tag (Ads/GA4) — ID "G-..." del panel de Google. Dispara pageviews
# en todo el sitio + evento `purchase` una vez por compra pagada.
GOOGLE_TAG_ID=
PUBLIC_WHATSAPP=569XXXXXXXX

# ── WhatsApp automatico (Meta Cloud API) — funcionalidad activable ─────
# El dia que se complete el setup en Meta (docs/whatsapp_api.md):
#   1. FEATURE_WHATSAPP_AUTO=True
#   2. Pegar token permanente + phone number id
#   3. restart-app
# Mientras tanto los avisos van por email + boton manual de WhatsApp.
FEATURE_WHATSAPP_AUTO=False
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Feature flags ───────────────────────────────────────────────────────
FEATURE_RESENAS=False
# Envios a domicilio. False = solo retiro en tienda (checkout sin
# direccion, cero menciones a envios en el sitio). Activar cuando se
# explore envio local / courier.
FEATURE_ENVIOS=False
# Emails transaccionales. Cada uno se activa cuando la duena valide
# el template con envios manuales y, para los programados (carrito,
# resena, recordatorio), cuando este montado el cron diario.
FEATURE_EMAIL_BIENVENIDA=False
# Reset de password ON: sin esto un cliente que olvida su clave no
# puede recuperarla (el flujo manda el link por email via Zoho).
FEATURE_EMAIL_RESET_PASSWORD=True
FEATURE_EMAIL_STOCK_DISPONIBLE=False
FEATURE_EMAIL_CARRITO_ABANDONADO=False
FEATURE_EMAIL_PEDIR_RESENA=False
FEATURE_EMAIL_RECORDATORIO_FAMILIA=False
