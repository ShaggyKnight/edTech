<clickhouse>
    <!-- Logs minimos: ClickHouse genera logs muy verbose por default.
         Para Plausible self-host de un solo tenant no necesitamos
         trace ni profile_events. Esto ahorra ~500MB/dia de disco. -->
    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>

    <!-- Query log apagado: en self-host single-tenant no aporta debug. -->
    <query_thread_log remove="remove"/>
    <query_log remove="remove"/>
    <text_log remove="remove"/>
    <trace_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <session_log remove="remove"/>
    <part_log remove="remove"/>
</clickhouse>
