# ════════════════════════════════════════════════════════════════════════
# .env para Plausible self-host (deploy/plausible/.env)
# ════════════════════════════════════════════════════════════════════════
# Copia este archivo a `.env` (sin .template), reemplazá las XXX y
# nunca lo commitees con secretos reales.
# ════════════════════════════════════════════════════════════════════════

# URL publica del panel de Plausible. Tiene que coincidir con el dominio
# del nginx reverse proxy y el cert TLS. NO incluir trailing slash.
BASE_URL=https://plausible.ideasboutique.cl

# Secret key del backend de Plausible. Generar UNA VEZ con:
#   openssl rand -base64 48
# Si la perdes, los usuarios existentes se deslogean (no rompe datos).
SECRET_KEY_BASE=GENERAR_CON_openssl_rand_base64_48_REEMPLAZAR_ESTO

# Password de postgres. Generar:
#   openssl rand -base64 24
POSTGRES_PASSWORD=GENERAR_CON_openssl_rand_base64_24_REEMPLAZAR_ESTO

# Apagar emails — Plausible NO va a mandar invitaciones, reset password,
# weekly reports, etc. Si en el futuro queres habilitar, switchear a
# Bamboo.SMTPAdapter y configurar MAILER_EMAIL + SMTP_* (puede reusar
# el smtp.zoho.com:587 ya configurado para Django).
MAILER_ADAPTER=Bamboo.LocalAdapter
MAILER_EMAIL=plausible@ideasboutique.cl

# Despues de que crees el primer usuario admin desde la web, setear esto
# en `true` para que la pagina /register quede cerrada. Sin esto, alguien
# que descubra el subdomain podria crearse cuenta.
# IMPORTANTE: cambiar a true SOLO despues del primer signup, hacer
# `docker compose up -d plausible` para recargar.
DISABLE_REGISTRATION=invite_only

# Cookie segura (HTTPS only). True en prod, false solo si tests locales
# sin TLS.
SECURE_COOKIE=true

# Listado de origins de los que se aceptan eventos. El dominio que el
# script de Plausible (que vive en plausible.ideasboutique.cl) va a
# trackear: la tienda en ideasboutique.cl.
# Plausible v3 no requiere esto explicito normalmente, pero lo dejamos
# documentado por si necesitas restringir.
